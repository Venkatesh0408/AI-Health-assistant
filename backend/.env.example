# ===================================
# AI Health Monitor Backend — Environment Variables
# ===================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Voice AI (Text-to-Speech) ---
# Supported providers: elevenlabs | openai | web_speech
VOICE_PROVIDER=elevenlabs
# Paste your ElevenLabs API key below:
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ElevenLabs Voice ID: 21m00Tcm4TlvDq8ikWAM (Rachel - warm, reassuring)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional OpenAI TTS key (if using OpenAI voices)
OPENAI_API_KEY=
OPENAI_VOICE=alloy
VOICE_ENABLED=true

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=replace-with-secure-random-secret-key
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Rate Limiting ---
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AI=10

# --- Image Upload ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
